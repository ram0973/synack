# /etc/synack/synack.env — права 600, владелец root или synack
WIKI_ADDR=127.0.0.1:3000
WIKI_DB=/var/lib/synack/wiki.db
WIKI_MEDIA=/var/lib/synack/media
RUST_LOG=wiki=info

# Пароль при первом запуске. Без него будет admin/admin, а в админке — баннер.
# Хеш: printf 'пароль' | ./wiki --hash-password
# WIKI_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...
